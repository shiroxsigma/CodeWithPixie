# venv / bytecode
.venv/
__pycache__/
*.pyc

# local config & secrets
config.json
.env

# runtime workspace contents (keep the folder, ignore its files)
/workspace/*
!/workspace/.gitkeep

# local test scratch
/testroot/

# ベンダライブラリは scripts/fetch_*.py で取得（README の手順参照）。
# monaco だけは取得スクリプトが無いため既存トラッキングを維持。
static/vendor/*
!static/vendor/monaco/

# pixie_core が workspace に作るランタイム状態（state_board 等）。
# Note の付箋 .pixie_notes.json（ファイル）は別物で保存対象なので除外しないこと。
.pixie_notes/

