[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
"uvicorn" = {extras = ["standard"], version = "*"}
pydantic-settings = "*"
python-dotenv = "*"
httpx = "*"         # /api/models (lists the active server's models; runtime dependency)
# --- Note mode (Stage C: dependencies of the modules ported from NWP) ---
pyyaml = "*"        # mdflow (conditional flow visualisation)
python-pptx = "*"   # extract: pptx text extraction
python-docx = "*"   # extract: docx text extraction
openpyxl = "*"      # extract: xlsx text extraction
pypdf = "*"         # extract: pdf text extraction

[dev-packages]
pytest = "*"
httpx = "*"  # for FastAPI's TestClient

[requires]
python_version = "3.12"
