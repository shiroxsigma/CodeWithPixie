[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
"uvicorn" = {extras = ["standard"], version = "*"}
pydantic-settings = "*"
python-dotenv = "*"
httpx = "*"         # /api/models（アクティブサーバのモデル一覧取得・実行時依存）
# --- Note モード（Stage C: NWP から移植したモジュールの依存）---
pyyaml = "*"        # mdflow（条件別フロー可視化）
python-pptx = "*"   # extract: pptx テキスト抽出
python-docx = "*"   # extract: docx テキスト抽出
openpyxl = "*"      # extract: xlsx テキスト抽出
pypdf = "*"         # extract: pdf テキスト抽出

[dev-packages]
pytest = "*"
httpx = "*"  # FastAPI TestClient 用

[requires]
python_version = "3.12"
