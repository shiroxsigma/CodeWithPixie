{
  "name": "code-with-pixie-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
